PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=focusflow
DB_PASSWORD=cambia-questa-password
DB_NAME=focusflow

# Almeno 32 caratteri casuali. Generane uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# true = chiunque può registrarsi dalla pagina di login; false = solo utenti creati con "npm run user:create"
ALLOW_REGISTER=true

# Solo dietro un proxy (nginx, Render…): quanti proxy ci sono davanti al server. Senza, tutti i client sembrano un solo IP.
# TRUST_PROXY=1

# Origine dell'app Android (Cordova), se chiama questo server
# CORS_ORIGIN=https://localhost
